# Clean URLs: /accountant/chart-of-accounts -> index.php (no .php in the address bar)
Options -Indexes -MultiViews
DirectoryIndex index.php

# Tells the app that these rewrite rules are active (it then builds clean URLs without /index.php)
SetEnv SBA_REWRITE 1

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect any *.php request (except the front controller) to its clean URL
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteCond %1 !^index$ [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # Serve real files/directories as they are (assets)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [QSA,L,E=SBA_REWRITE:1]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|jpg|webp|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
