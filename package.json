{
  "name": "sba-invento",
  "private": true,
  "description": "SBA Invento - SaaS accounting & inventory (PHP / MySQL / Tailwind CSS)",
  "scripts": {
    "build": "npm run build:css && npm run icons && npm run vendor",
    "build:css": "tailwindcss -i resources/css/app.css -o public/assets/css/app.css --minify",
    "watch": "tailwindcss -i resources/css/app.css -o public/assets/css/app.css --watch",
    "icons": "node scripts/copy-icons.mjs",
    "vendor": "mkdir -p public/assets/vendor/cropperjs && cp node_modules/cropperjs/dist/cropper.min.js node_modules/cropperjs/dist/cropper.min.css node_modules/cropperjs/LICENSE public/assets/vendor/cropperjs/"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "cropperjs": "^1.6.2",
    "lucide-static": "^1.69.0",
    "tailwindcss": "^4.3.4"
  }
}
