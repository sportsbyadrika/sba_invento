# =====================================================================
# Root .htaccess - for shared hosting where the domain's document root
# is the project folder (e.g. /home/olympicd/federaerp.com).
# Everything is routed into /public; source folders are blocked.
# If you CAN point the document root to /public, this file is not used.
# =====================================================================
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Let cPanel AutoSSL / Let's Encrypt validate the domain (keep this first)
    RewriteRule ^\.well-known/ - [L]

    # 2. Force HTTPS - uncomment once the SSL certificate is active
    # RewriteCond %{HTTPS} !=on
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 3. Block source code, configuration, logs and hidden files
    RewriteRule ^(app|config|database|bin|storage|views|resources|scripts|docs|node_modules|vendor)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(README\.md|package(-lock)?\.json|composer\.(json|lock)|hallsons\.htm|\.cpanel\.yml)$ - [F,L]

    # 4. Send every other request into /public (clean URLs are handled there)
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Without mod_rewrite nothing can be served safely
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

# ---------------------------------------------------------------------
# cPanel "MultiPHP Manager" writes a block like the one below into this
# file. Because deployments overwrite this file, paste cPanel's block
# here (between the markers) and commit it, e.g.:
#
# # php -- BEGIN cPanel-generated handler, do not edit
# <IfModule mime_module>
#   AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
# </IfModule>
# # php -- END cPanel-generated handler, do not edit
# ---------------------------------------------------------------------
